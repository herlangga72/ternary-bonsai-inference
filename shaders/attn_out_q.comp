#version 450
// Quantized-V attention output: dequantize each cached value coordinate, form
// the probability-weighted sum in rotated space, then inverse-rotate once.
//
// One workgroup per query head; lane d owns dimension d of the output head.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Pr { float data[]; } prob;
layout(set = 0, binding = 1, std430) readonly buffer V { uint data[]; } vc;
layout(set = 0, binding = 2, std430) buffer O { float data[]; } o;
layout(set = 0, binding = 3, std430) readonly buffer P { float data[]; } p;
layout(push_constant) uniform PC {
    uint nheads;
    uint n_pos;
    uint hd;
    uint n_kv;
    uint bits;
    uint pwords;
    uint cent_off;
    uint pad;
} pc;

shared float acc[256];

void main() {
    uint h = gl_WorkGroupID.x;
    uint lid = gl_LocalInvocationID.x;
    uint hd = pc.hd;
    uint kvheads = pc.n_kv;
    uint kv = h / (pc.nheads / kvheads);

    uint mask = (1u << pc.bits) - 1u;
    uint row_words = pc.pwords + 1u;
    uint bits = pc.bits;
    // This lane owns coordinate `lid`; precompute where its field lives.
    uint b0 = 0u, s0 = 0u;
    if (bits == 3u) {
        // 8 coords per 3-byte group; this lane's 3 bits start at bit 3*(lid%8).
        b0 = 3u * (lid >> 3u); s0 = 3u * (lid & 7u);
    } else if (bits == 2u) {
        b0 = lid >> 2u; s0 = 2u * (lid & 3u);
    } else if (bits == 4u) {
        b0 = lid >> 1u; s0 = 4u * (lid & 1u);
    }
    // Bitstream fallback (widths 5..8) precomputed once for this lane.
    uint fbitpos = lid * bits;
    uint fbyte = fbitpos >> 3u;
    uint foff = fbitpos & 7u;
    uint fwi0 = fbyte >> 2u;
    uint fsh0 = 8u * (fbyte & 3u) + foff;
    bool fneed2 = (foff + bits) > 8u;
    uint fwi1 = (fbyte + 1u) >> 2u;
    uint fsh1 = 8u * ((fbyte + 1u) & 3u);
    uint fhimask = (fneed2 ? (1u << (foff + bits - 8u)) : 0u) - 1u;

    float a = 0.0;
    for (uint pos = 0u; pos < pc.n_pos; ++pos) {
        float pr = prob.data[h * pc.n_pos + pos];
        if (pr == 0.0) { continue; }
        uint base = (pos * pc.n_kv + kv) * row_words;
        uint v;
        if (bits == 3u) {
            uint by = b0;
            uint gv = (vc.data[base + (by >> 2u)] >> (8u * (by & 3u))) & 0xffu;
            by++;
            gv |= ((vc.data[base + (by >> 2u)] >> (8u * (by & 3u))) & 0xffu) << 8u;
            by++;
            gv |= ((vc.data[base + (by >> 2u)] >> (8u * (by & 3u))) & 0xffu) << 16u;
            v = (gv >> s0) & 7u;
        } else if (bits == 2u) {
            v = (vc.data[base + (b0 >> 2u)] >> (8u * (b0 & 3u) + s0)) & 3u;
        } else if (bits == 4u) {
            v = (vc.data[base + (b0 >> 2u)] >> (8u * (b0 & 3u) + s0)) & 0xfu;
        } else {
            v = (vc.data[base + fwi0] >> fsh0) & mask;
            if (fneed2) {
                v |= ((vc.data[base + fwi1] >> fsh1) & fhimask) << (8u - foff);
            }
        }
        float nrm = uintBitsToFloat(vc.data[base + pc.pwords]);
        a += pr * nrm * p.data[pc.cent_off + v];
    }
    acc[lid] = a;
    barrier();

    uint g = lid >> 1u;
    float x0 = acc[2u * g];
    float x1 = acc[2u * g + 1u];
    float cc = p.data[2u * g];
    float ss = p.data[2u * g + 1u];
    float outv = ((lid & 1u) == 0u) ? (cc * x0 + ss * x1) : (-ss * x0 + cc * x1);
    o.data[h * hd + lid] = outv;
}
