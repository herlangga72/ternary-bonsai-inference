#version 450
// Append one token's k or v row block into a per-layer cache at position pos.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer R { float data[]; } row;
layout(set = 0, binding = 1, std430) buffer C { float data[]; } cache;
layout(push_constant) uniform PC { uint pos; uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    cache.data[pc.pos * pc.n + i] = row.data[i];
}
