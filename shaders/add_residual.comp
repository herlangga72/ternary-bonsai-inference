#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer A { float data[]; } x;
layout(set = 0, binding = 1, std430) readonly buffer B { float data[]; } a;
layout(set = 0, binding = 2, std430) buffer O { float data[]; } o;
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    o.data[i] = x.data[i] + a.data[i];
}
