#version 450

// Fused elementwise ops for the decoder. Bindings: 0 = a (and gate input),
// 1 = b (optional second input), 2 = o. Push: { uint n; uint mode; }.
// Modes (mirror kernels.rs):
//   0 silu(a)          1 sigmoid(a)       2 softplus(a)
//   3 silu(a) * b      (FFN gate-up)      4 sigmoid(a) * b  (attn gate)
//   5 sigmoid(a)*b with silu on b reserved
// Dispatch ceil(n/256) workgroups of 256.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer A { float data[]; } a;
layout(set = 0, binding = 1, std430) readonly buffer B { float data[]; } b;
layout(set = 0, binding = 2, std430) buffer       O { float data[]; } o;

layout(push_constant) uniform PC {
    uint n;
    uint mode;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    float av = a.data[i];
    float r;
    if (pc.mode == 0u) {
        r = av / (1.0f + exp(-av));             // silu
    } else if (pc.mode == 1u) {
        r = 1.0f / (1.0f + exp(-av));           // sigmoid
    } else if (pc.mode == 2u) {
        r = av > 20.0f ? av : log(1.0f + exp(av)); // softplus
    } else if (pc.mode == 3u) {
        float s = av / (1.0f + exp(-av));       // silu(a) * b
        r = s * b.data[i];
    } else {
        float s = 1.0f / (1.0f + exp(-av));     // sigmoid(a) * b
        r = s * b.data[i];
    }
    o.data[i] = r;
}
