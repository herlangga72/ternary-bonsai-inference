#version 450
// Fused attn_q rows are [q(hd) | gate(hd)] per head; separate them.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer F { float data[]; } f;
layout(set = 0, binding = 1, std430) buffer Q { float data[]; } q;
layout(set = 0, binding = 2, std430) buffer G { float data[]; } g;
layout(push_constant) uniform PC { uint hd; uint pad; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x; // head * hd + d
    uint head = i / pc.hd;
    uint d = i % pc.hd;
    uint fbase = head * (2u * pc.hd);
    q.data[i] = f.data[fbase + d];
    g.data[i] = f.data[fbase + pc.hd + d];
}
