#version 450

// Row-wise norms used by the decoder. Bindings: 0 = x, 1 = w (weights, only
// for rms mode), 2 = o. Push: { uint total; uint len; uint mode; float eps; }.
// mode 0 = rms_norm_rows (o = x * w[j] * rsqrt(mean(x^2)+eps) per row),
// mode 1 = l2_norm_rows   (o = x / max(sqrt(sum x^2), eps), no w).
// One workgroup (256 lanes) per row; row_len <= 256 here (head 256, state
// 128), so each lane covers one element and the reduction is one pass.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InX { float data[]; } x;
layout(set = 0, binding = 1, std430) readonly buffer InW { float data[]; } w;
layout(set = 0, binding = 2, std430) buffer       Out  { float data[]; } o;

layout(push_constant) uniform PC {
    uint total;
    uint len;
    uint mode;
    float eps;
} pc;

shared float sums[256];

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.x;
    uint start = row * pc.len;
    uint n = pc.len;

    float ss = 0.0f;
    for (uint i = lid; i < n; i += 256u) {
        float v = x.data[start + i];
        ss = fma(v, v, ss);
    }
    sums[lid] = ss;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (lid < s) { sums[lid] += sums[lid + s]; }
        barrier();
    }
    float scale;
    if (lid == 0u) {
        if (pc.mode == 0u) {
            scale = 1.0f / sqrt(sums[0] / float(n) + pc.eps);
        } else {
            scale = 1.0f / max(sqrt(sums[0]), pc.eps);
        }
        sums[0] = scale;
    }
    barrier();
    scale = sums[0];
    for (uint i = lid; i < n; i += 256u) {
        float v = x.data[start + i];
        float g = (pc.mode == 0u) ? w.data[i] : 1.0f;
        o.data[start + i] = v * scale * g;
    }
}
